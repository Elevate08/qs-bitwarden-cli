#!/bin/bash
# File-backed keyring: one file per `account` attribute.
cmd="$1"; shift
account=""; while [ $# -gt 0 ]; do case "$1" in account) account="$2"; shift 2;; *) shift;; esac; done
mkdir -p "$FAKE_KEYRING"; f="$FAKE_KEYRING/$account"
case "$cmd" in
  lookup) [ -f "$f" ] || exit 1; cat "$f"; echo ;;
  # A slow session store, so a switch reliably lands while one is running.
  store) case "$account" in session*) sleep "${FAKE_SESSION_STORE_DELAY:-0}" ;; esac
    cat > "$f.tmp" && mv "$f.tmp" "$f" ;;
  clear) [ -f "$f" ] || exit 1; rm -f "$f" ;;
  search) [ -f "$f" ] && cat "$f"; exit 0 ;;
  *) exit 2 ;;
esac
