#%PAM-1.0
#
# FIDO2 presence check for qs-bitwarden-cli's "unlock with FIDO2 key" option.
#
# This stack lives in the plugin's own directory and is loaded through
# Quickshell's PamContext `configDirectory`, which maps to Linux-PAM's
# pam_start_confdir. Nothing here is installed under /etc/pam.d, so enabling
# the option needs no privileged step. Only `auth` rules are read: PamContext
# runs pam_authenticate and nothing else.
#
# The credential is Omarchy's own global registration (`omarchy setup security
# fido2` writes /etc/fido2/fido2), the same authfile /etc/pam.d/sudo and
# polkit-1 already use. No origin= or appid= is given, so the relying party
# stays pam-u2f's default pam://$HOSTNAME -- which is exactly what that one
# registration was created for. Presenting a different origin would fail every
# key touch against it.
#
# `cue` asks pam-u2f to print a "touch the device" message, which the panel
# shows as the scan prompt. A device without a client PIN (this one) needs only
# the touch; pam-u2f never asks for a PIN it cannot use.
auth       required                    pam_u2f.so authfile=/etc/fido2/fido2 cue
